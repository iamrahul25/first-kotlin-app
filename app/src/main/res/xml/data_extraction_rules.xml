<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup for Android 12 and newer. Settings, limits, steps, badges, history and the
   photos/art files are restored on reinstall, so setup isn't repeated. Usage access and
   accessibility are Android permissions and must still be allowed again after reinstall.
   See https://developer.android.com/about/versions/12/backup-restore
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="."/>
    </device-transfer>
</data-extraction-rules>
