<?xml version="1.0" encoding="utf-8"?>
<!-- Only window changes, and no access to window content: TimeWise just needs the app in front. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/app_limit_service_description"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="300"
    android:settingsActivity="com.nightwise.timewise.MainActivity" />
